# ─────────────────────────────────────────────────────────────
# Fitviyo landing — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA-your-site-key
TURNSTILE_SECRET=0x4AAAAAAA-your-secret-key

# Resend (resend.com → API Keys). Verify fitviyo.com domain first.
RESEND_API_KEY=re_your_api_key

# Public site URL (used for canonical, sitemap, share links)
NEXT_PUBLIC_SITE_URL=https://fitviyo.com

# Google Search Console verification (optional).
# Search Console -> Add property -> HTML tag -> copy the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
